# ---- Server ----
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
SHORT_URL_BASE=http://localhost:3000
# Set to true behind a load balancer / reverse proxy so client IPs come from X-Forwarded-For.
TRUST_PROXY=false
# Cache-Control max-age for redirects. 0 = no-store (every click is counted).
REDIRECT_CACHE_MAX_AGE_SECONDS=0

# ---- Postgres ----
DATABASE_URL=postgres://urlshort:urlshort@localhost:5432/urlshort

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- Kafka / Redpanda (click analytics) ----
KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLICK_TOPIC=click-events
KAFKA_CLICK_TOPIC_PARTITIONS=6
KAFKA_CONSUMER_GROUP=click-writer

# ---- Auth ----
# Required in production: random, 32+ characters (e.g. `openssl rand -hex 32`).
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN_SECONDS=3600
BCRYPT_ROUNDS=12
IP_HASH_SALT=change-me-in-production

# ---- Rate limits (per client IP) ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_CREATE_MAX=100
RATE_LIMIT_CREATE_WINDOW_MS=3600000
RATE_LIMIT_REDIRECT_MAX=1000
RATE_LIMIT_REDIRECT_WINDOW_MS=60000
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_AUTH_WINDOW_MS=60000

# ---- Workers ----
WORKER_METRICS_PORT=9101
CLEANUP_INTERVAL_MS=3600000
