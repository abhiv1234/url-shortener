{
  "name": "url-shortener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/copy-migrations.mjs",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "migrate:prod": "node dist/db/migrate.js",
    "worker": "tsx src/workers/clickConsumer.ts",
    "cleanup": "tsx src/workers/expiredUrlCleaner.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "INTEGRATION=1 vitest run tests/integration --no-file-parallelism",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "check": "npm run lint && npm run typecheck && npm test",
    "load-test": "node scripts/load-test.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "^11.2.2",
    "@fastify/swagger": "^9.9.5",
    "@fastify/swagger-ui": "^6.1.4",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.12.8",
    "fastify-plugin": "^5.1.0",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "kafkajs": "^2.2.4",
    "pg": "^8.12.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.5.4",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^5.1.0",
    "autocannon": "^8.0.0",
    "eslint": "^9.39.5",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.4",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  },
  "description": "Horizontally scalable URL shortener: Fastify + PostgreSQL + Redis cache-aside + Kafka click analytics, with JWT auth, rate limiting and Prometheus metrics.",
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  }
}
